# Copie para .env na raiz e substitua todos os valores change-me.
# Este arquivo contem apenas placeholders; nunca versione o .env real.

POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me-postgres-admin
POSTGRES_ADMIN_DB=postgres
POSTGRES_PORT=5432

ESCALA_DB_NAME=escala_core
ESCALA_DB_USER=escala_api_user
ESCALA_DB_PASSWORD=change-me-escala-db

STRAPI_DB_NAME=strapi_cms
STRAPI_DB_USER=strapi_user
STRAPI_DB_PASSWORD=change-me-strapi-db

REDIS_PUBLIC_PORT=6379
REDIS_PASSWORD=

BACKEND_PORT=8080
BACKEND_JWT_SECRET=replace-with-at-least-32-random-bytes-base64
INTERNAL_BFF_SHARED_SECRET=replace-with-a-long-random-value

STRAPI_PORT=1337
STRAPI_PUBLIC_URL=http://localhost:1337
STRAPI_APP_KEYS=replace-key-1,replace-key-2,replace-key-3,replace-key-4
STRAPI_API_TOKEN_SALT=replace-with-random-value
STRAPI_ADMIN_JWT_SECRET=replace-with-random-value
STRAPI_TRANSFER_TOKEN_SALT=replace-with-random-value
STRAPI_JWT_SECRET=replace-with-random-value
STRAPI_ENCRYPTION_KEY=replace-with-random-value
STRAPI_CRON_ENABLED=false

FRONTEND_PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-value
NEXT_PUBLIC_COMPANY_SLUG=escala-demo
NEXT_PUBLIC_RECAPTCHA_ENABLED=false

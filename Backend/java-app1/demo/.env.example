# Configuração do banco de dados
DB_HOST=postgres
DB_PORT=5432
DB_NAME=escala_core
DB_USER=escala_api_user
DB_PASS=change-me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=replace-with-a-base64-secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Integrações
STRAPI_BASE_URL=http://strapi:1337
GOOGLE_CLIENT_ID=
RECAPTCHA_SECRET=
INTERNAL_BFF_SHARED_SECRET=change-me-with-a-long-random-value
PUBLIC_ENDPOINTS_REQUIRE_BFF=true
TRUSTED_PROXIES=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIAL=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_CRITICAL=

# Perfil
SPRING_PROFILES_ACTIVE=development

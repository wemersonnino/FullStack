# Exemplo para docker-compose.prod.yml. Use um secret manager em producao.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-secret
POSTGRES_ADMIN_DB=postgres
ESCALA_DB_NAME=escala_core
ESCALA_DB_USER=escala_api_user
ESCALA_DB_PASSWORD=replace-with-secret
STRAPI_DB_NAME=strapi_cms
STRAPI_DB_USER=strapi_user
STRAPI_DB_PASSWORD=replace-with-secret
REDIS_PASSWORD=replace-with-secret
BACKEND_PORT=8080
BACKEND_JWT_SECRET=replace-with-secret
INTERNAL_BFF_SHARED_SECRET=replace-with-secret
STRAPI_PORT=1337
STRAPI_PUBLIC_URL=https://cms.example.com
STRAPI_APP_KEYS=replace-key-1,replace-key-2,replace-key-3,replace-key-4
STRAPI_API_TOKEN_SALT=replace-with-secret
STRAPI_ADMIN_JWT_SECRET=replace-with-secret
STRAPI_TRANSFER_TOKEN_SALT=replace-with-secret
STRAPI_JWT_SECRET=replace-with-secret
STRAPI_ENCRYPTION_KEY=replace-with-secret
STRAPI_CRON_ENABLED=true
DATABASE_SSL=true
FRONTEND_PORT=3000
NEXTAUTH_URL=https://app.example.com
NEXTAUTH_SECRET=replace-with-secret
